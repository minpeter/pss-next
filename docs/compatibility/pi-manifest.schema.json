{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minpeter/pss-runtime/blob/main/docs/compatibility/pi-manifest.schema.json",
  "title": "PSS Pi compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "baseline",
    "classifications",
    "surfaces"
  ],
  "properties": {
    "$schema": {
      "const": "./pi-manifest.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "repository", "release", "commit"],
      "properties": {
        "project": {
          "const": "Pi"
        },
        "repository": {
          "const": "https://github.com/badlogic/pi-mono"
        },
        "release": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "classifications": {
      "const": [
        "native",
        "adapter",
        "planned",
        "intentional-difference:ai-sdk",
        "intentional-difference:durable-execution"
      ]
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "classification": {
                "const": "intentional-difference:ai-sdk"
              }
            },
            "required": ["classification"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "classification": {
                "const": "intentional-difference:durable-execution"
              }
            },
            "required": ["classification"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "classification", "summary", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "native",
            "adapter",
            "planned",
            "intentional-difference:ai-sdk",
            "intentional-difference:durable-execution"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["upstream", "local"],
          "properties": {
            "upstream": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "local": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
