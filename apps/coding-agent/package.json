{
  "name": "@minpeter/pss-coding-agent",
  "version": "0.0.14-next.18",
  "description": "Code at the speed of thought",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minpeter/pss-runtime.git",
    "directory": "apps/coding-agent"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@minpeter/pss-source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "@minpeter/pss-source": "./src/env.ts",
      "import": "./dist/env.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "@minpeter/pss-source": "./src/model.ts",
      "import": "./dist/model.js"
    },
    "./thread-config": {
      "types": "./dist/thread-config.d.ts",
      "@minpeter/pss-source": "./src/thread-config.ts",
      "import": "./dist/thread-config.js"
    },
    "./thread-inspect": {
      "types": "./dist/thread-inspect.d.ts",
      "@minpeter/pss-source": "./src/thread-inspect.ts",
      "import": "./dist/thread-inspect.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "@minpeter/pss-source": "./src/tools.ts",
      "import": "./dist/tools.js"
    },
    "./instructions": {
      "types": "./dist/instructions.d.ts",
      "@minpeter/pss-source": "./src/instructions.ts",
      "import": "./dist/instructions.js"
    },
    "./workspace-tools": {
      "types": "./dist/workspace-tools/index.d.ts",
      "@minpeter/pss-source": "./src/workspace-tools/index.ts",
      "import": "./dist/workspace-tools/index.js"
    },
    "./tui": {
      "types": "./dist/tui/app.d.ts",
      "@minpeter/pss-source": "./src/tui/app.ts",
      "import": "./dist/tui/app.js"
    },
    "./extension": {
      "types": "./dist/extensions/index.d.ts",
      "@minpeter/pss-source": "./src/extensions/index.ts",
      "import": "./dist/extensions/index.js"
    },
    "./providers": {
      "types": "./dist/provider-registry.d.ts",
      "@minpeter/pss-source": "./src/provider-registry.ts",
      "import": "./dist/provider-registry.js"
    },
    "./extension/legacy": {
      "types": "./dist/extensions/legacy.d.ts",
      "@minpeter/pss-source": "./src/extensions/legacy.ts",
      "import": "./dist/extensions/legacy.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pss": "./bin/pss.js",
    "pss-coding-agent": "./bin/pss.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "ultracite check .",
    "preview:assistant": "tsx --conditions=@minpeter/pss-source scripts/preview-assistant-render.ts",
    "preview:edit": "tsx --conditions=@minpeter/pss-source scripts/preview-edit-render.ts",
    "start": "tsx --conditions=@minpeter/pss-source src/tui/app.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.36",
    "@ai-sdk/openai": "4.0.31",
    "@ai-sdk/openai-compatible": "3.0.20",
    "@earendil-works/pi-tui": "^0.84.1",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@minpeter/opensearch": "0.1.3",
    "@minpeter/pss-runtime": "workspace:^",
    "@resvg/resvg-wasm": "2.6.2",
    "@t3-oss/env-core": "^0.13.11",
    "ai": "7.0.51",
    "beautiful-mermaid": "1.1.3",
    "dotenv": "^17.4.2",
    "fast-png": "8.0.0",
    "mathjax": "4.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@minpeter/pss-extension-latex": "workspace:^",
    "@minpeter/pss-extension-mermaid": "workspace:^",
    "@minpeter/pss-extension-web": "workspace:^",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
