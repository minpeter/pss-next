{
  "name": "@minpeter/pss-benchmark-compaction-score",
  "private": true,
  "type": "module",
  "scripts": {
    "block-time": "tsx --conditions=@minpeter/pss-source runtime-block-time-cli.ts",
    "campaigns": "tsx --conditions=@minpeter/pss-source campaign-aggregation.ts",
    "compare": "tsx --conditions=@minpeter/pss-source compare-reports.ts",
    "deadline-outcome": "tsx --conditions=@minpeter/pss-source runtime-deadline-outcome-cli.ts",
    "deadline-outcome-validate": "tsx --conditions=@minpeter/pss-source runtime-deadline-outcome-validator-cli.ts",
    "deadline-sweep": "tsx --conditions=@minpeter/pss-source deadline-sweep-cli.ts",
    "deadline-sweep-validate": "tsx --conditions=@minpeter/pss-source deadline-sweep-validator-cli.ts",
    "five-track-report": "tsx --conditions=@minpeter/pss-source five-track-cli.ts",
    "human-calibration": "tsx --conditions=@minpeter/pss-source human-calibration-cli.ts",
    "packets": "tsx --conditions=@minpeter/pss-source export-packets.ts",
    "production-overlap": "tsx --conditions=@minpeter/pss-source production-overlap-cli.ts",
    "production-overlap-validate": "tsx --conditions=@minpeter/pss-source production-overlap-validator-cli.ts",
    "quality-sweep": "tsx --conditions=@minpeter/pss-source quality-sweep-cli.ts",
    "quality-sweep-validate": "tsx --conditions=@minpeter/pss-source quality-sweep-validator-cli.ts",
    "score": "tsx --conditions=@minpeter/pss-source run.ts",
    "screen": "tsx --conditions=@minpeter/pss-source profile-screening.ts",
    "table": "tsx --conditions=@minpeter/pss-source comparison-report-cli.ts",
    "task-utility": "tsx --conditions=@minpeter/pss-source task-utility-cli.ts",
    "task-utility-validate": "tsx --conditions=@minpeter/pss-source task-utility-validator-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@minpeter/pss-coding-agent": "workspace:*",
    "@minpeter/pss-runtime": "workspace:*",
    "ai": "7.0.51"
