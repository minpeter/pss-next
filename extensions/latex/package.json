{
  "name": "@minpeter/pss-extension-latex",
  "version": "0.0.1-next.4",
  "description": "Self-contained LaTeX display rendering for the PSS coding-agent TUI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minpeter/pss-runtime.git",
    "directory": "extensions/latex"
  },
  "type": "module",
  "exports": {
    ".": {
      "@minpeter/pss-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "ultracite check .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@resvg/resvg-wasm": "2.6.2",
    "fast-png": "8.0.0",
    "mathjax": "4.1.3"
  },
  "devDependencies": {
    "playwright-core": "1.62.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": "^0.82.1",
    "@minpeter/pss-coding-agent": "^0.0.14-next.14"
  },
  "engines": {
    "node": ">=24"
  }
}
